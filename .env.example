# Google Gemini AI Config
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MONTHLY_BUDGET_USD=50.00

# Instagram Local Chrome Automation (CDP)
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=.chrome-profile

# Meta Official Graph API & Webhook (Etapa 2 Handoff)
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=buscando_milhao_webhook_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Database SQLite
DATABASE_URL=data/buscandomilhao.sqlite

# Operating Limits & Cadence
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo
